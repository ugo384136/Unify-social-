{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "User profile representation in UNIFY Socials",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "description": "Unique Google / Firebase Auth UID"
        },
        "email": {
          "type": "string",
          "description": "User email address"
        },
        "displayName": {
          "type": "string",
          "description": "User display name"
        },
        "username": {
          "type": "string",
          "description": "Unique handle"
        },
        "avatarUrl": {
          "type": "string",
          "description": "Avatar photo URL"
        },
        "bio": {
          "type": "string",
          "description": "Profile biography"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Creation timestamp"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Update timestamp"
        }
      },
      "required": ["userId", "email", "displayName", "username", "createdAt", "updatedAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "UserProfile",
      "description": "Stores user profile and account details keyed by user ID"
    }
  }
}
